# Runtime-мусор: пишется в $HERMES_HOME и не должен попадать в git.
__pycache__/
*.pyc
audit.jsonl
ephemeral.json
policy.json
policy.json.bak*
*.log
.DS_Store
# Собранный установщик: артефакт сборки, а не исходник (8 МБ на каждый коммит).
dist/

# Секреты: .env живёт в $HERMES_HOME, в репозиторий не попадает никогда.
# Репозиторий публичный, поэтому шаблон исключений — часть продукта, а не удобство.
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
*.p12
*token*.json
credentials*.json
*secret*.json
